# Configuration de la base de données
# Copier ce fichier et le renommer en 'db.properties'
# Puis configurer avec vos paramètres PostgreSQL

# Paramètres de connexion PostgreSQL
db.host=localhost
db.port=5432
db.name=cinema_db
db.username=cinema_user
db.password=votre_mot_de_passe

# URL JDBC complète (générée automatiquement)
db.url=jdbc:postgresql://${db.host}:${db.port}/${db.name}

# Configuration du pool de connexions HikariCP
db.pool.maximumPoolSize=10
db.pool.minimumIdle=5
db.pool.connectionTimeout=30000
db.pool.idleTimeout=600000
db.pool.maxLifetime=1800000

# Mode debug (true/false)
db.debug=false
